{
  "expo": {
    "name": "client",
    "slug": "client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.client.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-file-system",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Client to access your camera to take geotagged photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Client to use your location to geotag photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Client to save photos to your library.",
          "savePhotosPermission": "Allow Client to save photos to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}